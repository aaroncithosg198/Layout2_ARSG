<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Layout2_ARSG.MainPage">
	<Grid Padding="15"
          BackgroundColor="#0B0913"
          RowSpacing="10"
          ColumnSpacing="10">

		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Pantalla -->
		<Entry  x:Name="Display"
                Text="0"
                TextColor="White"
                FontSize="48"
                BackgroundColor="#0B0913"
                HorizontalTextAlignment="End"
                VerticalTextAlignment="Center"
                IsReadOnly="True"
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="4"/>

		<!-- Primera fila -->
		<Button Text="C"
                BackgroundColor="#292238"
                TextColor="Indianred"
                FontSize="22"
                CornerRadius="40"
                Grid.Row="1"
                Grid.Column="0"
                Clicked="Limpiar_Clicked"/>

		<Button Text="DEL"
                BackgroundColor="#292238"
                TextColor="IndianRed"
                FontSize="18"
                CornerRadius="40"
                Grid.Row="1"
                Grid.Column="1"
                Clicked="Borrar_Clicked"/>

		<Button Text="%"
                BackgroundColor="#292238"
                TextColor="White"
                FontSize="24"
                CornerRadius="40"
                Grid.Row="1"
                Grid.Column="2"/>

		<Button Text="÷"
                BackgroundColor="Gray"
                TextColor="White"
                FontSize="24"
                CornerRadius="40"
                Grid.Row="1"
                Grid.Column="3"
                Clicked="Operador_Clicked"/>

		<!-- Segunda fila -->
		<Button Text="7"
                BackgroundColor="#292238"
                TextColor="White"
                FontSize="24"
                CornerRadius="40"
                Grid.Row="2"
                Grid.Column="0"
                Clicked="Numero_Clicked"/>

		<Button Text="8"
                BackgroundColor="#292238"
                TextColor="White"
                FontSize="24"
                CornerRadius="40"
                Grid.Row="2"
                Grid.Column="1"
                Clicked="Numero_Clicked"/>
                

		<Button Text="9"
                BackgroundColor="#292238"
                TextColor="White"
                FontSize="24"
                CornerRadius="40"
                Grid.Row="2"
                Grid.Column="2"
                Clicked="Numero_Clicked"/>

		<Button Text="×"
                BackgroundColor="Gray"
                TextColor="White"
                FontSize="24"
                CornerRadius="40"
                Grid.Row="2"
                Grid.Column="3"
                Clicked="Operador_Clicked"/>

		<!-- Tercera fila -->
		<Button Text="4"
                BackgroundColor="#292238"
                TextColor="White"
                FontSize="24"
                CornerRadius="40"
                Grid.Row="3"
                Grid.Column="0"
                Clicked="Numero_Clicked"/>

		<Button Text="5"
                BackgroundColor="#292238"
                TextColor="White"
                FontSize="24"
                CornerRadius="40"
                Grid.Row="3"
                Grid.Column="1"
                Clicked="Numero_Clicked"/>

		<Button Text="6"
                BackgroundColor="#292238"
                TextColor="White"
                FontSize="24"
                CornerRadius="40"
                Grid.Row="3"
                Grid.Column="2"
                Clicked="Numero_Clicked"/>

		<Button Text="−"
                BackgroundColor="Gray"
                TextColor="White"
                FontSize="24"
                CornerRadius="40"
                Grid.Row="3"
                Grid.Column="3"
                Clicked="Operador_Clicked"/>

		<!-- Cuarta fila -->
		<Button Text="1"
                BackgroundColor="#292238"
                TextColor="White"
                FontSize="24"
                CornerRadius="40"
                Grid.Row="4"
                Grid.Column="0"
                Clicked="Numero_Clicked"/>

		<Button Text="2"
                BackgroundColor="#292238"
                TextColor="White"
                FontSize="24"
                CornerRadius="40"
                Grid.Row="4"
                Grid.Column="1"
                Clicked="Numero_Clicked"/>

		<Button Text="3"
                BackgroundColor="#292238"
                TextColor="White"
                FontSize="24"
                CornerRadius="40"
                Grid.Row="4"
                Grid.Column="2"
                Clicked="Numero_Clicked"/>

		<Button Text="+"
                BackgroundColor="Gray"
                TextColor="White"
                FontSize="24"
                CornerRadius="40"
                Grid.Row="4"
                Grid.Column="3"
                Clicked="Operador_Clicked"/>

		<!-- Quinta fila -->
		<Button Text="( )"
                BackgroundColor="#292238"
                TextColor="White"
                FontSize="19"
                CornerRadius="40"
                Grid.Row="5"
                Grid.Column="0"/>

		<Button Text="0"
                BackgroundColor="#292238"
                TextColor="White"
                FontSize="24"
                CornerRadius="40"
                Grid.Row="5"
                Grid.Column="1"
                Clicked="Numero_Clicked"/>

		<Button Text="."
                BackgroundColor="#292238"
                TextColor="White"
                FontSize="24"
                CornerRadius="40"
                Grid.Row="5"
                Grid.Column="2"
                Clicked="Decimal_Clicked"/>

		<Button Text="="
                BackgroundColor="DarkGreen"
                TextColor="White"
                FontSize="28"
                CornerRadius="40"
                Grid.Row="5"
                Grid.Column="3"
                Clicked="Igual_Clicked"/>
	</Grid>
</ContentPage>
